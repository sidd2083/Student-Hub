rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ── Users ────────────────────────────────────────────────────────────────
    // • Any signed-in user may read profiles (needed for leaderboard).
    // • Owners may update their own doc BUT cannot change server-managed or
    //   privileged fields — those are only written by the Admin SDK or admins.
    // • Numeric fields are bounded to prevent stat injection.
    // • Only admins may elevate roles, modify badges, or delete accounts.
    match /users/{uid} {
      allow read: if isSignedIn();

      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.role == 'user'
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.grade is int
        && request.resource.data.grade >= 9
        && request.resource.data.grade <= 12;

      allow update: if isAdmin()
        || (isOwner(uid)
          // ── Privileged / server-only fields — never writable by the client ──
          // role: no privilege escalation
          // uid: no identity spoofing
          // badges: server / admin only — prevents fake badge injection
          // hasEarnedStreakToday: internal streak guard, server-only
          && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['role', 'uid', 'badges', 'hasEarnedStreakToday'])

          // ── Bounded numeric fields ────────────────────────────────────────
          // totalStudyTime: must not decrease, max +240 min per write
          && (!('totalStudyTime' in request.resource.data)
              || (request.resource.data.totalStudyTime is int
                  && request.resource.data.totalStudyTime >= resource.data.get('totalStudyTime', 0)
                  && request.resource.data.totalStudyTime <= resource.data.get('totalStudyTime', 0) + 240))

          // streak: can only stay same, increase by 1, or reset to 0
          && (!('streak' in request.resource.data)
              || (request.resource.data.streak is int
                  && request.resource.data.streak >= 0
                  && request.resource.data.streak <= 3650
                  && (request.resource.data.streak == resource.data.get('streak', 0)
                      || request.resource.data.streak == resource.data.get('streak', 0) + 1
                      || request.resource.data.streak == 0)))

          // todayStudyTime: 0–1440 (one full day in minutes)
          && (!('todayStudyTime' in request.resource.data)
              || (request.resource.data.todayStudyTime is int
                  && request.resource.data.todayStudyTime >= 0
                  && request.resource.data.todayStudyTime <= 1440))

          // lastActiveDate: must be a valid YYYY-MM-DD string if provided
          && (!('lastActiveDate' in request.resource.data)
              || (request.resource.data.lastActiveDate is string
                  && request.resource.data.lastActiveDate.size() == 10
                  && request.resource.data.lastActiveDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'))));

      allow delete: if isAdmin();
    }

    // ── Tasks ────────────────────────────────────────────────────────────────
    match /tasks/{taskId} {
      allow read:   if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500;
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        // uid cannot be changed on update
        && request.resource.data.uid == resource.data.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // ── Study Logs ───────────────────────────────────────────────────────────
    // Users may only read/write their own daily log.
    // studyMinutes is bounded to 1440 (24 h) and cannot be set by another user.
    match /study_logs/{logId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;

      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.studyMinutes is int
        && request.resource.data.studyMinutes >= 0
        && request.resource.data.studyMinutes <= 1440;

      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        // uid cannot change on update
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.studyMinutes is int
        && request.resource.data.studyMinutes >= 0
        && request.resource.data.studyMinutes <= 1440;
    }

    // ── Notes — public read, admin write ─────────────────────────────────────
    match /notes/{noteId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── PYQs — public read, admin write ──────────────────────────────────────
    match /pyqs/{pyqId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── MCQs — public read, admin write ──────────────────────────────────────
    match /mcqs/{mcqId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── Announcements — public read, admin write ──────────────────────────────
    match /announcements/{announcementId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── SEO Meta — public read, admin write ───────────────────────────────────
    match /seo_meta/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Daily Missions ────────────────────────────────────────────────────────
    // Doc ID is "{uid}_{date}". Owners may read/write their own mission docs.
    // resource == null check allows getDoc on a non-existent doc to succeed.
    match /daily_missions/{docId} {
      allow read: if isSignedIn()
        && (resource == null || resource.data.uid == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.uid == request.auth.uid;
    }

    // ── Saved Items ──────────────────────────────────────────────────────────
    match /saved_items/{itemId} {
      allow read:   if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.itemType is string
        && request.resource.data.itemType.size() > 0
        && request.resource.data.itemType.size() <= 20
        && request.resource.data.itemId is string
        && request.resource.data.itemId.size() > 0
        && request.resource.data.itemId.size() <= 100;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // ── Study Rooms ───────────────────────────────────────────────────────────
    // Any signed-in user may list / read rooms (needed to browse & join).
    // Only the host may change timer state, room status, or sensitive fields.
    // Any participant may update participantCount by ±1 (batch with join/leave).
    match /studyRooms/{roomId} {
      // Anyone can browse/read rooms (unauthenticated users can see room listings)
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.status == 'waiting'
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 60;

      allow update: if isSignedIn() && (
        // Host may update anything (timer, status, phase, participant count…)
        resource.data.hostUid == request.auth.uid
        // Non-hosts may only update participantCount (join / leave via increment)
        || request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['participantCount'])
      );

      allow delete: if isSignedIn()
        && resource.data.hostUid == request.auth.uid;

      // ── Participants subcollection ────────────────────────────────────────
      // Each user owns their own participant doc (uid == doc ID).
      match /participants/{uid} {
        allow read:   if isSignedIn();
        allow create: if isSignedIn()
          && request.auth.uid == uid
          && request.resource.data.uid == uid;
        allow update: if isSignedIn() && request.auth.uid == uid;
        allow delete: if isSignedIn() && request.auth.uid == uid;
      }

      // ── Votes subcollection ───────────────────────────────────────────────
      // Any participant may start or cast a vote.
      // Updates are restricted to the voter-arrays and status field only.
      match /votes/{voteId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.createdByUid == request.auth.uid
          && request.resource.data.status == 'active'
          && request.resource.data.yesVoters.size() == 0
          && request.resource.data.noVoters.size() == 0;
        allow update: if isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['yesVoters', 'noVoters', 'status']);
      }

      // ── Messages subcollection ────────────────────────────────────────────
      // Participants can send short chat messages; no editing / deleting.
      match /messages/{msgId} {
        allow read:   if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 200;
      }
    }

    // ── Study Room Sessions ───────────────────────────────────────────────────
    // Written when a user leaves a room (records study time for that session).
    match /studyRoomSessions/{sessionId} {
      allow read:   if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;
    }
  }
}
