rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ── Users ────────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isSignedIn();

      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.role == 'user'
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.grade is int
        && request.resource.data.grade >= 9
        && request.resource.data.grade <= 12;

      allow update: if isAdmin()
        || (isOwner(uid)
          && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['role', 'uid', 'badges', 'hasEarnedStreakToday'])

          && (!('totalStudyTime' in request.resource.data)
              || (request.resource.data.totalStudyTime is int
                  && request.resource.data.totalStudyTime >= resource.data.get('totalStudyTime', 0)
                  // Cap per-write increment at 60 min (1 hour) — prevents looping scripts
                  // from inflating leaderboard totalStudyTime via direct Firestore writes.
                  // The secure /api/study/save endpoint is the canonical write path.
                  && request.resource.data.totalStudyTime <= resource.data.get('totalStudyTime', 0) + 60))

          && (!('streak' in request.resource.data)
              || (request.resource.data.streak is int
                  && request.resource.data.streak >= 0
                  && request.resource.data.streak <= 3650
                  && (request.resource.data.streak == resource.data.get('streak', 0)
                      || request.resource.data.streak == resource.data.get('streak', 0) + 1
                      || request.resource.data.streak == 0)))

          && (!('todayStudyTime' in request.resource.data)
              || (request.resource.data.todayStudyTime is int
                  && request.resource.data.todayStudyTime >= 0
                  && request.resource.data.todayStudyTime <= 1440))

          && (!('lastActiveDate' in request.resource.data)
              || (request.resource.data.lastActiveDate is string
                  && request.resource.data.lastActiveDate.size() == 10
                  && request.resource.data.lastActiveDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'))));

      allow delete: if isAdmin();
    }

    // ── Tasks ────────────────────────────────────────────────────────────────
    match /tasks/{taskId} {
      allow read:   if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500;
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // ── Study Logs ───────────────────────────────────────────────────────────
    match /study_logs/{logId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;

      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.studyMinutes is int
        && request.resource.data.studyMinutes >= 0
        && request.resource.data.studyMinutes <= 1440;

      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.studyMinutes is int
        // Non-decreasing: can never lower study minutes for a given day log.
        && request.resource.data.studyMinutes >= resource.data.get('studyMinutes', 0)
        // Cap per-write increment at 60 min — prevents inflating report card data directly.
        && request.resource.data.studyMinutes <= resource.data.get('studyMinutes', 0) + 60;
    }

    // ── Notes — public read, admin write ─────────────────────────────────────
    match /notes/{noteId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── PYQs — public read, admin write ──────────────────────────────────────
    match /pyqs/{pyqId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── MCQs — public read, admin write ──────────────────────────────────────
    match /mcqs/{mcqId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── Announcements — public read, admin write ──────────────────────────────
    match /announcements/{announcementId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── SEO Meta — public read, admin write ───────────────────────────────────
    match /seo_meta/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Daily Missions ────────────────────────────────────────────────────────
    match /daily_missions/{docId} {
      allow read: if isSignedIn()
        && (resource == null || resource.data.uid == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.uid == request.auth.uid;
    }

    // ── Saved Items ──────────────────────────────────────────────────────────
    match /saved_items/{itemId} {
      allow read:   if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.itemType is string
        && request.resource.data.itemType.size() > 0
        && request.resource.data.itemType.size() <= 20
        && request.resource.data.itemId is string
        && request.resource.data.itemId.size() > 0
        && request.resource.data.itemId.size() <= 100;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // ── Study Rooms ───────────────────────────────────────────────────────────
    match /studyRooms/{roomId} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.status == 'waiting'
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 60;

      allow update: if isSignedIn() && (
        // Host may update anything
        resource.data.hostUid == request.auth.uid

        // Admin may update anything
        || isAdmin()

        // Non-hosts: only participantCount (join / leave via increment)
        || request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['participantCount'])

        // Last participant leaving: allowed to mark room as finished
        || (request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['participantCount', 'status', 'timerStartedAt'])
            && request.resource.data.participantCount == 0
            && request.resource.data.status == 'finished')
      );

      // Host or admin may delete a room
      allow delete: if isSignedIn()
        && (resource.data.hostUid == request.auth.uid || isAdmin());

      // ── Participants subcollection ────────────────────────────────────────
      match /participants/{uid} {
        allow read:   if isSignedIn();
        allow create: if isSignedIn()
          && request.auth.uid == uid
          && request.resource.data.uid == uid;
        allow update: if isSignedIn() && (request.auth.uid == uid || isAdmin());
        allow delete: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      }

      // ── Votes subcollection ───────────────────────────────────────────────
      match /votes/{voteId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.createdByUid == request.auth.uid
          && request.resource.data.status == 'active'
          && request.resource.data.yesVoters.size() == 0
          && request.resource.data.noVoters.size() == 0;
        allow update: if isSignedIn() && (
          // Any participant may cast/change their own vote (voter arrays only)
          request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['yesVoters', 'noVoters'])
          // Only the room host may resolve a vote (change status field)
          // Prevents any user from forging a passed/failed/expired outcome.
          || (request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['yesVoters', 'noVoters', 'status'])
              && get(/databases/$(database)/documents/studyRooms/$(roomId)).data.hostUid
                   == request.auth.uid)
        );
        allow delete: if isAdmin();
      }

      // ── Messages subcollection ────────────────────────────────────────────
      // Supports both text messages and emoji reactions
      match /messages/{msgId} {
        allow read:   if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.uid == request.auth.uid
          && (
            // Text messages: require non-empty text within length limit
            (request.resource.data.type == 'message'
              && request.resource.data.text is string
              && request.resource.data.text.size() > 0
              && request.resource.data.text.size() <= 200)
            // Emoji reactions: require emoji field
            || (request.resource.data.type == 'reaction'
              && request.resource.data.emoji is string
              && request.resource.data.emoji.size() > 0
              && request.resource.data.emoji.size() <= 10)
            // 'system' type intentionally excluded — only the backend (Admin SDK)
            // may post system messages (host-transfer, kick notices, etc.).
            // Allowing clients to create system messages would let users forge
            // official-looking announcements inside any room.
          );
        allow delete: if isAdmin();
      }
    }

    // ── Study Room Sessions ───────────────────────────────────────────────────
    match /studyRoomSessions/{sessionId} {
      allow read:   if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;
    }
  }
}
