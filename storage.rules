rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── Profile avatars ────────────────────────────────────────────────────────
    // Strict: only jpeg/png/webp, max 2 MB, authenticated owner only.
    // Prevents SVG (XSS), executable, video or oversized uploads for avatars.
    match /avatars/{uid} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid.replace('.jpg', '').replace('.jpeg', '').replace('.png', '').replace('.webp', '')
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType.matches('image/jpeg|image/png|image/webp');
    }

    // General avatar fallback path (uid subdirectory pattern)
    match /avatars/{allPaths=**} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType.matches('image/jpeg|image/png|image/webp');
    }

    // ── Content files (notes / PYQs) ─────────────────────────────────────────
    // Public read so students can view without signing in.
    // Write requires authentication, max 5 MB, images + PDF only.
    // Restricted to specific safe formats — SVG/GIF/HEIC excluded.
    // NOTE: Admin SDK uploads (from the backend) bypass these rules entirely.
    match /notes/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/jpeg|image/png|image/webp|application/pdf');
    }

    match /pyqs/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/jpeg|image/png|image/webp|application/pdf');
    }

    // ── All other authenticated paths ─────────────────────────────────────────
    // Requires authentication for both read and write.
    // Restricts to specific safe image formats + PDF.
    // Blocks: SVG (XSS), GIF, HEIC, executables, scripts, videos, audio.
    match /{allPaths=**} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/jpeg|image/png|image/webp|application/pdf');
    }
  }
}
