{
  "buildCommand": "pnpm --filter @workspace/api-server run build && pnpm --filter @workspace/student-hub run build && node scripts/generate-sitemap.mjs",
  "outputDirectory": "artifacts/student-hub/dist/public",
  "installCommand": "pnpm install",
  "framework": null,
  "functions": {
    "api/index.mjs": {
      "memory": 512,
      "maxDuration": 30,
      "includeFiles": "artifacts/student-hub/dist/public/index.html"
    },
    "api/ai/chat.mjs": {
      "memory": 512,
      "maxDuration": 30
    },
    "api/ping.mjs": {
      "memory": 128,
      "maxDuration": 5
    }
  },
  "rewrites": [
    { "source": "/api/(.*)",    "destination": "/api/index" },
    { "source": "/notes/:path*","destination": "/api/index" },
    { "source": "/pyq/:path*",  "destination": "/api/index" },
    { "source": "/(.*)",        "destination": "/index.html" }
  ]
}
